{
    "name": "colorish",
    "version": "2.0.0",
    "description": "The official manager for all Colorways-compatible apps",
    "main": "./out/main/index.js",
    "author": {
        "name": "DaBluLite",
        "email": "dablulite@gmail.com"
    },
    "homepage": "https://github.com/ProjectColorway/colorish",
    "repository": {
        "url": "https://github.com/ProjectColorway/colorish"
    },
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win --config build.config.json",
        "build:mac": "electron-vite build && electron-builder --mac --config build.config.json",
        "build:linux": "electron-vite build && electron-builder --linux --config build.config.json",
        "build:publish": "cross-env NODE_ENV=production electron-vite build && electron-builder -w -p onTagOrDraft --config build.config.json"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.1",
        "@electron-toolkit/utils": "^3.0.0",
        "@react-spring/web": "^10.0.1",
        "@tailwindcss/vite": "^4.1.1",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "appdata-path": "^1.0.0",
        "babel-plugin-react-compiler": "19.0.0-beta-bafa41b-20250307",
        "cors": "^2.8.5",
        "electron-updater": "^6.1.7",
        "eslint-plugin-react-compiler": "19.0.0-beta-bafa41b-20250307",
        "express": "^5.1.0",
        "flux": "^4.0.4",
        "flyonui": "^1.3.0",
        "highlight.js": "^11.11.1",
        "idb": "^8.0.1",
        "mime-types": "^2.1.35",
        "react-colorful": "^5.6.1",
        "react-compiler": "^1.0.3",
        "tailwindcss": "^4.0.12",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^2.0.0",
        "@electron-toolkit/eslint-config-ts": "^2.0.0",
        "@electron-toolkit/tsconfig": "^1.0.1",
        "@stylistic/eslint-plugin": "^2.12.1",
        "@types/flux": "^3.1.14",
        "@types/node": "^20.14.8",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.1",
        "@types/ws": "^8.5.13",
        "@vitejs/plugin-react": "^4.3.1",
        "cross-env": "^7.0.3",
        "electron": "^31.0.2",
        "electron-builder": "^24.13.3",
        "electron-vite": "^2.3.0",
        "eslint": "^8.57.0",
        "eslint-plugin-path-alias": "^2.1.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.1.4",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "typescript": "^5.5.2",
        "typescript-eslint": "^8.19.1",
        "vite": "^5.3.1"
    }
}